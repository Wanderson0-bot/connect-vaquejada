{
  "name": "pdm-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "db:check-neon": "node scripts/apply-neon-migrations.mjs --check",
    "db:check-neon-env": "node --env-file-if-exists=.env.local scripts/check-neon-env.mjs",
    "db:verify-neon": "node --env-file-if-exists=.env.local scripts/apply-neon-migrations.mjs --verify",
    "db:migrate-neon": "node --env-file-if-exists=.env.local scripts/apply-neon-migrations.mjs --apply",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start:backend": "node .render-build/backend/server.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "coordinator": "node coordinator/server.mjs",
    "coordinator:backup": "node coordinator/backup.mjs"
  },
  "dependencies": {
    "@neon/env": "^1.6.6",
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/postgrest-js": "2.79.0",
    "better-auth": "1.7.14",
    "lucide-react": "^0.468.0",
    "pg": "8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@neon/config": "^1.9.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
