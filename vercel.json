{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://connect-vaquejada-backend.onrender.com/api/auth/:path*"
    },
    {
      "source": "/api/register",
      "destination": "https://connect-vaquejada-backend.onrender.com/api/register"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
