# Connect Vaquejada - exemplo local (copie para .env.local e substitua pelos endpoints do projeto Neon)
# Necessárias no frontend para Auth e Data API.
VITE_NEON_AUTH_BASE_URL=https://SEU-PROJETO.neonauth.example
VITE_NEON_DATA_API_URL=https://SEU-PROJETO.neondata.example
# Opcional: URL do branch Neon, usada para derivar os endpoints acima quando eles não forem definidos.
# Não exponha DATABASE_URL no frontend nem use o prefixo VITE_ para credenciais.
# VITE_NEON_URL=https://SEU-PROJETO.neon.tech

# URL pública do backend hospedado no Render; configure também no Vercel.
VITE_BACKEND_API_URL=https://SEU-SERVICO.onrender.com

# Segredos do backend /api/event-access (configure no Render, não no Vercel).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-DO-BANCO/BASE?sslmode=require
NEON_AUTH_BASE_URL=https://SEU-PROJETO.neonauth.example
NEON_DATA_API_URL=https://SEU-PROJETO.neondata.example
# Troque por um segredo aleatório com pelo menos 32 caracteres.
EVENT_ACCESS_PASSWORD_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_CARACTERES_OU_MAIS
# Origens exatas do site público e dos painéis no Vercel, separadas por vírgula.
BACKEND_ALLOWED_ORIGINS=https://SEU-SITE.vercel.app
# Somente para validar/aplicar migrations no branch isolado TESTE.
# Use a URL direta (sem -pooler); nunca use a URL de producao neste processo.
NEON_BRANCH=TESTE
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@HOST-DIRETO-TESTE.neon.tech/BASE?sslmode=require

# Opcional: destinatario usado pelo formulario publico (mailto; configure tambem no build do Vercel).
VITE_PUBLIC_CONTACT_EMAIL=
