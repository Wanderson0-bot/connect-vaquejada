# Exemplo de ambiente para iniciar o coordenador local.
# Configure estes valores no serviço do sistema operacional; não publique o token.
CONNECT_PDM_PARK_ID=ID-DO-PARQUE
CONNECT_PDM_TOKEN=gere-um-segredo-aleatorio-com-mais-de-24-caracteres
CONNECT_PDM_DB=data/connect-pdm.sqlite
CONNECT_PDM_HOST=0.0.0.0
CONNECT_PDM_PORT=8787
# Para HTTPS, configure certificado confiável e chave no host:
# CONNECT_PDM_TLS_CERT=C:/caminho/certificado.pem
# CONNECT_PDM_TLS_KEY=C:/caminho/chave-privada.pem
# CONNECT_PDM_ALLOWED_ORIGINS=http://localhost:5173
